# ─────────────────────────────────────────────────────────
# Document Intake Assistant — root .gitignore
# ─────────────────────────────────────────────────────────

# ─── Secrets — NEVER commit ──────────────────────────────
backend/.env
**/.env

# ─── Python ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/

# ─── Virtual environments ─────────────────────────────────
backend/venv/
backend/.venv/
venv/
.venv/

# ─── Python tests / coverage ─────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ─── Node / Frontend ─────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.vite/

# ─── IDE ─────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ─── Logs ────────────────────────────────────────────────
*.log
